{
  "id": "OhmSavvyWriter01",
  "name": "OhmSavvy: write an article (local Ollama)",
  "nodes": [
    {
      "parameters": {
        "path": "ohmsavvy-write-article",
        "formTitle": "Write an OhmSavvy article",
        "formDescription": "Drafts a buying guide with Ollama on this laptop, using only verified product data, and runs the 5 QA checkpoints. It takes about 10–25 minutes; keep this tab open and the review page appears here when it's ready.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Keyword",
              "placeholder": "Leave blank for the next keyword in the queue",
              "requiredField": false
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "buttonLabel": "Write article"
        }
      },
      "id": "w1",
      "name": "Write article form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0
      ],
      "webhookId": "ohmsavvy-write-article"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4700/draft",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ keyword: $json.Keyword || '' }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "w2",
      "name": "Start draft",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ohmsavvyWriterToken",
          "name": "OhmSavvy writer service (x-token)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "w3c",
              "leftValue": "={{ $json.statusCode === 409 && $json.body.state === 'running' }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w3",
      "name": "Busy writing another?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Already writing",
        "completionMessage": "={{ 'Another article is being written right now (' + $json.body.keyword + '). Try again when it has finished.' }}"
      },
      "id": "w4",
      "name": "Busy",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        660,
        -160
      ]
    },
    {
      "parameters": {
        "amount": 60,
        "unit": "seconds"
      },
      "id": "w5",
      "name": "Wait 1 minute",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        660,
        40
      ],
      "webhookId": "ohmsavvy-wait"
    },
    {
      "parameters": {
        "url": "http://host.docker.internal:4700/status",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "w6",
      "name": "Check status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ohmsavvyWriterToken",
          "name": "OhmSavvy writer service (x-token)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "w7c",
              "leftValue": "={{ $json.body.state }}",
              "rightValue": "running",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w7",
      "name": "Still writing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "w8c",
              "leftValue": "={{ $json.body.state }}",
              "rightValue": "ready",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w8",
      "name": "Draft ready?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        120
      ]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "The draft didn't pass QA",
        "completionMessage": "={{ 'Nothing was published. Last log lines:\\n\\n' + ($json.body.log || '').split('\\n').slice(-12).join('\\n') }}"
      },
      "id": "w9",
      "name": "Failed",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        1540,
        260
      ]
    },
    {
      "parameters": {
        "formFields": {
          "values": [
            {
              "fieldLabel": "Review",
              "fieldType": "html",
              "html": "={{ (() => {\n  const s = $json.body;\n  const icon = { pass: '✅', fail: '❌', skipped: '➖' };\n  const rows = (s.qa || []).map(c => '<tr><td>' + (icon[c.status] || '') + '</td><td><b>' + c.name + '</b><br><small>' + (c.notes || []).join('<br>') + '</small></td></tr>').join('');\n  return '<p><b>' + s.keyword + '</b>: ' + s.pageWords + ' words</p>'\n    + '<p><a href=\"' + s.previewUrl + '\" target=\"_blank\" style=\"font-size:18px\">▶ Open the preview</a></p>'\n    + '<table style=\"width:100%;text-align:left;font-size:13px\">' + rows + '<tr><td>✋</td><td><b>6. Your review</b><br><small>Read the preview, then choose below.</small></td></tr></table>';\n})() }}"
            },
            {
              "fieldLabel": "Decision",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Publish"
                  },
                  {
                    "option": "Discard"
                  }
                ]
              },
              "requiredField": true
            }
          ]
        },
        "options": {
          "formTitle": "Draft ready: review it",
          "buttonLabel": "Confirm"
        }
      },
      "id": "w10",
      "name": "Review draft",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        1540,
        40
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "w11c",
              "leftValue": "={{ $json.Decision }}",
              "rightValue": "Publish",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "w11",
      "name": "Publish?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1760,
        40
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4700/publish",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "w12",
      "name": "Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ohmsavvyWriterToken",
          "name": "OhmSavvy writer service (x-token)"
        }
      }
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "={{ $json.statusCode === 200 ? 'Published ✓' : 'Publish failed' }}",
        "completionMessage": "={{ $json.statusCode === 200 ? 'Live in about 2 minutes at ' + $json.body.liveUrl + '. The Facebook autoposter will share it in its next slot.' : ($json.body.error || 'Unknown error') }}"
      },
      "id": "w13",
      "name": "Published",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        2200,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:4700/discard",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "id": "w14",
      "name": "Discard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ohmsavvyWriterToken",
          "name": "OhmSavvy writer service (x-token)"
        }
      }
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Discarded",
        "completionMessage": "The draft was deleted and its keyword is back in the queue."
      },
      "id": "w15",
      "name": "Discarded",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        2200,
        140
      ]
    }
  ],
